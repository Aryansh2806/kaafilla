# Kaafilla backend config. Copy this file to .env, then restart Metro: npx expo start -c
# (EXPO_PUBLIC_* vars are inlined at bundle time — a restart is required after edits;
#  rebuild for standalone/release builds. Never commit .env — it's git-ignored.)
#
# ── Hosted project (what the team uses) ─────────────────────────────────────────
# Ready to use as-is: `cp .env.example .env`, then `npx expo start -c`. Without a
# valid .env the app falls back to the bundled seed (src/data/seed.ts) and won't
# show live data. This is the anon (publishable) key — safe to ship in the client;
# the database is protected by RLS. Rotate it in Supabase if it ever needs revoking.
EXPO_PUBLIC_SUPABASE_URL=https://idvsngmwvpsfmupsgcpi.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlkdnNuZ213dnBzZm11cHNnY3BpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMzk2MjQsImV4cCI6MjEwMTYxNTYyNH0.OmEIcVGS-XI2i76k1-Ma0tLZCZK_P1Re-0He-XJnm2w

# ── Local Supabase alternative (supabase start / colima) ────────────────────────
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321   # iOS simulator / web
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321    # Android emulator → host loopback
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase start`>
