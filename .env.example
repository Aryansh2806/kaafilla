# Copy to .env and fill in. The app runs on local seed data when these are unset,
# and switches to Supabase (with zero code changes) once they're present.

# Local Supabase (from `supabase start` output). 127.0.0.1 works from the iOS simulator.
# For a hosted project, use the project URL + anon key from the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-start
